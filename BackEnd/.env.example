# ---------- server ----------
NODE_ENV=development
PORT=8000
# LOG_LEVEL=debug

# ---------- database ----------
MONGODB_URI=mongodb://localhost:27017
# Optional – database name (falls back to the one in MONGODB_URI)
DB_NAME=videotube

# ---------- security ----------
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_EXPIRY=10d
BCRYPT_SALT_ROUNDS=10
# Number of reverse proxies in front of the app (Render/Heroku = 1)
TRUST_PROXY=1

# ---------- rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# ---------- media ----------
# "cloudinary" in real deployments, "mock" for local dev/tests without a Cloudinary account
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=videotube

API_DOCS_ENABLED=true
